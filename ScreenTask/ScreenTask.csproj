<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>file_icon.ico</ApplicationIcon>
    <StartupObject>ScreenTask.Program</StartupObject>
    <Version>2.0.0</Version>
    <AssemblyTitle>ScreenTask 2.0</AssemblyTitle>
    <Description>ScreenTask - Free Open Source Offline and Local Network Screen Sharing</Description>
    <Authors>Eslam Hamouda</Authors>
    <Copyright>Copyright © 2014-2026 Eslam Hamouda</Copyright>
    <LangVersion>13.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="WebServer\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="file_icon.ico" />
    <Content Include="screenicon.ico" />
  </ItemGroup>

</Project>